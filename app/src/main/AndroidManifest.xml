<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- AdMob requires network for ad delivery. The editor and private photos remain local. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <application android:theme="@android:style/Theme.Material.Light.NoActionBar" android:label="Esquelas y Avisos de Luto" android:icon="@drawable/app_icon" android:roundIcon="@drawable/app_icon" android:allowBackup="false" android:enableOnBackInvokedCallback="true" android:supportsRtl="true">
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="${ADMOB_APP_ID}"/>
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="unspecified" android:windowSoftInputMode="adjustResize">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
        </activity>
    </application>
</manifest>
